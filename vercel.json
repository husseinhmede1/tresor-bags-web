{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://tresor-bags-web-node.onrender.com/sitemap.xml"
    },
    {
      "source": "/gallery/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|WhatsApp|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot).*"
        }
      ],
      "destination": "https://tresor-bags-web-node.onrender.com/share/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
